---
const {title,description,path,image='/wp-content/uploads/2026/08/Window-Cleaning-Calculator-Full-Logo-with-background-square.png',article}=Astro.props;
const origin='https://windowcleaningcalculator.co.uk';
const titleFull=title+' | Window Cleaning Calculator';
const canonical=origin+path;
const absolute=(value)=>new URL(value,origin).href;
const schema=article?{'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:article.date,image:absolute(image),author:{'@type':'Organization',name:'Window Cleaning Calculator'},mainEntityOfPage:canonical}:{'@context':'https://schema.org','@type':'CollectionPage',name:title,description,url:canonical};
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{titleFull}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/wcc-icon-192.png"/><meta property="og:title" content={titleFull}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={absolute(image)}/><meta property="og:type" content={article?'article':'website'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={absolute(image)}/><script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=Average+Sans&family=Domine:wght@400;600;700&display=swap" rel="stylesheet"/></head><body>
<header><div class="wrap header"><a href="/" aria-label="Window Cleaning Calculator home"><img width="85" height="85" src="/wp-content/uploads/2026/08/Window-Cleaning-Calculator-small-full-screen-Logo-transaprent-300x300.png" alt="Window Cleaning Calculator"/></a><nav aria-label="Main navigation"><a href="/#calculator">Calculator</a><a href="/window-cleaning-prices-uk/">Prices</a><a href="/guides/" aria-current={path==='/guides/'?'page':undefined}>Guides</a></nav><a class="button header-cta" href="/#calculator">Calculate a price</a></div></header>
<main><slot/></main>
<footer><div class="wrap footer"><strong>Window Cleaning Calculator</strong><p>Free, independent window cleaning price guidance for the UK.</p><nav aria-label="Footer"><a href="/#calculator">Calculator</a><a href="/guides/">Guides</a><a href="/privacy-policy/">Privacy policy</a><a href="/terms-of-use/">Terms of use</a></nav></div></footer></body></html>
<style is:global>
:root{--paper:#fcfdf5;--ink:#1f2113;--orange:#ff681f;--olive:#6e7448;--line:#dce0cd}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:18px/1.65 'Average Sans',Arial,sans-serif}a{color:inherit;text-underline-offset:4px}a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}h1,h2,h3{font-family:Domine,Georgia,serif;line-height:1.18;font-weight:600}h1{font-size:clamp(38px,6vw,68px);letter-spacing:-.035em;margin:16px 0 22px}h2{font-size:clamp(26px,3vw,38px)}h3{font-size:23px}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}header{background:var(--paper);border-bottom:1px solid var(--line)}.header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 0}.header nav,footer nav{display:flex;gap:22px;flex-wrap:wrap}.header nav a{text-decoration:none}.header img{display:block;object-fit:contain}.button{display:inline-block;padding:12px 22px;background:var(--orange);color:#1f2113;text-decoration:none;font-weight:bold;border-radius:6px}.hero{padding:75px 0 64px;background:#f0f2e5}.hero p:not(.eyebrow){max-width:680px;font-size:21px}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:14px;font-weight:bold;color:var(--olive)}section.content{padding:42px 0}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tile{display:block;background:white;border:1px solid var(--line);border-radius:10px;padding:25px;text-decoration:none}.tile h3{margin:8px 0 14px}.tile:hover{border-color:var(--orange)}.tile img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:6px}.tile span{color:#8b370b;font-weight:bold}.reading{max-width:760px;margin:auto;padding:48px 20px}.reading img{width:100%;height:auto;border-radius:10px}.reading p,.reading li{max-width:72ch}.reading h2{margin-top:38px}.footer{padding:30px 0 45px}footer{background:#1f2113;color:var(--paper)}@media(max-width:760px){.grid{grid-template-columns:1fr}.header{flex-wrap:wrap;gap:10px}.header nav{order:3;width:100%;padding:8px 0;gap:22px}.header img{width:68px;height:68px}.header-cta{padding:9px 14px}.hero{padding:44px 0}.wrap{width:calc(100% - 32px)}}
</style>