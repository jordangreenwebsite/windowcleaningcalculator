---
import GuideLayout from '../../components/GuideLayout.astro';
import {guidePosts} from '../../data/guide-posts.mjs';
const pricing=[
['Window cleaning prices in the UK','/window-cleaning-prices-uk/'],['Window cleaning cost per window','/window-cleaning-prices-uk/window-cleaning-cost-per-window/'],['Prices by property type','/window-cleaning-prices-uk/window-cleaning-prices-by-property-type/'],['First window clean cost','/window-cleaning-prices-uk/first-window-cleaning-cost/'],['One-off window cleaning','/window-cleaning-prices-uk/one-off-window-cleaning-cost/'],['Inside window cleaning','/window-cleaning-prices-uk/inside-window-cleaning-cost/'],['Conservatory cleaning cost','/window-cleaning-prices-uk/conservatory-cleaning-cost/'],['Conservatory roof cleaning cost','/window-cleaning-prices-uk/conservatory-roof-cleaning-cost/'],['Prices by area','/window-cleaning-prices-uk/window-cleaning-prices-by-area/'],['How we calculate prices','/window-cleaning-prices-uk/how-we-calculate-prices/'],['Commercial window cleaning cost','/window-cleaning-prices-uk/commercial-window-cleaning-cost/']];
const posts=[...guidePosts].sort((a,b)=>b.date.localeCompare(a.date));
---
<GuideLayout title="Window cleaning guides" description="Practical UK window cleaning guides for homeowners and professional window cleaners. Understand estimates, compare quotes and plan your pricing." path="/guides/">
<section class="hero"><div class="wrap"><p class="eyebrow">For homeowners and window cleaners</p><h1>Window cleaning guides</h1><p>Understand what goes into a window cleaning price, compare quotes with confidence and make better decisions about regular cleaning or running your own round.</p><a class="button" href="/#calculator">Get a free price estimate</a></div></section>
{posts.length>0&&<section class="content wrap"><h2>Latest guides</h2><div class="grid">{posts.map(p=><a class="tile" href={'/guides/'+p.slug+'/'}><img src={p.image} alt={p.imageAlt} loading="lazy" width="640" height="360"/><h3>{p.title}</h3><p>{p.description}</p><span>Read guide</span></a>)}</div></section>}
<section class="content wrap"><p class="eyebrow">Understand your quote</p><h2>UK window cleaning prices</h2><p>Explore our existing pricing resources before using the calculator or asking for a quote.</p><div class="grid">{pricing.map(([label,href])=><a class="tile" href={href}><h3>{label}</h3><span>Read guide</span></a>)}</div></section>
<section class="content wrap"><h2>For professional window cleaners</h2><p>We will cover practical pricing decisions, route planning and sustainable business costs. In the meantime, use our calculator to explore estimates and understand how the different factors affect a quote.</p><a class="button" href="/#calculator">Open the calculator</a></section></GuideLayout>