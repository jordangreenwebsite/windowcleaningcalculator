---
import Base from '../../layouts/Base.astro';

const path = '/window-cleaning-prices-uk/how-often-should-windows-be-cleaned/';

// These multipliers match PRICING.frequency in src/widgets/calculator.html.
// They describe this calculator's price model, not a UK industry price index.
const schedules = [
  {weeks:'4', name:'Every 4 weeks', factor:'1.00×', difference:'Baseline', label:'Regular upkeep', detail:'Useful where you want consistently clean glass and a predictable routine.'},
  {weeks:'6', name:'Every 6 weeks', factor:'1.08×', difference:'+8% per visit', label:'Middle ground', detail:'Fewer visits than four-weekly cleaning, while still keeping a regular schedule.'},
  {weeks:'8', name:'Every 8 weeks', factor:'1.20×', difference:'+20% per visit', label:'Less frequent', detail:'A sensible option to compare when you do not need the windows cleaned every month.'},
  {weeks:'12', name:'Every 12 weeks', factor:'1.35×', difference:'+35% per visit', label:'Occasional upkeep', detail:'Longer gaps between cleans; heavier build-up may need more attention on each visit.'},
  {weeks:'—', name:'One-off clean', factor:'1.55×', difference:'+55% per visit', label:'One visit', detail:'A standalone clean without the ongoing rounds and repeat visits of a regular customer.'}
];
const questions = [
  {q:'Is cleaning windows every four weeks necessary?',a:'Not for every property. Four-weekly cleaning makes sense when you want consistently clear windows, but exposure, weather, glazing and your preference determine how often you actually need a visit.'},
  {q:'Is six-weekly or eight-weekly window cleaning cheaper?',a:'There are fewer visits across the year, which may reduce the annual spend. The price per visit can be higher, however. Compare the full annual cost rather than assuming a less frequent schedule always saves the most.'},
  {q:'Will the first clean cost more?',a:'It can. Dirt, frames and sills may need extra attention on the initial visit, so the calculator treats first-clean condition separately from the regular schedule.'},
  {q:'Does the same schedule suit inside windows?',a:'Not necessarily. Inside glass may stay clean for longer or need more frequent attention if there are pets, children or heavy use. Our calculator lets you select inside cleaning separately.'},
  {q:'How do I get a price for my own house?',a:'Use our free calculator and enter your postcode area, property details, window counts, access and preferred cleaning frequency. The result is an estimate, not a guaranteed quotation.'}
];
---
<Base title="How Often Should Windows Be Cleaned? | UK Schedule Guide" description="Compare 4, 6, 8 and 12-weekly window cleaning, one-off cleans and how frequency affects estimated costs. A practical UK guide for homeowners and cleaners." path={path}>
  <section class="article-hero schedule-hero">
    <div class="container schedule-hero-grid">
      <div>
        <p class="eyebrow">WINDOW CLEANING GUIDES <span class="hero-divider" aria-hidden="true">/</span> CLEANING FREQUENCY</p>
        <h1>How often should windows be cleaned?</h1>
        <p class="article-intro">Four, six, eight or twelve weeks? The right schedule depends on how quickly your windows get dirty, the level of upkeep you prefer and what your cleaner charges per visit.</p>
        <div class="schedule-actions">
          <a class="button button-primary" href="#compare">Compare schedules <span aria-hidden="true">↓</span></a>
          <a class="button button-outline" href="/#calculator">Calculate my price <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="schedule-overview" aria-label="Window cleaning schedule at a glance">
        <p class="overview-kicker">YOUR CLEANING ROUTINE</p>
        <div class="overview-track" aria-hidden="true">
          <div><span>04</span><small>WEEKS</small></div>
          <div><span>06</span><small>WEEKS</small></div>
          <div><span>08</span><small>WEEKS</small></div>
          <div><span>12</span><small>WEEKS</small></div>
        </div>
        <p class="overview-title">Regular cleaning is a choice, not a fixed rule.</p>
        <p class="overview-note">Start with the options below, then use the calculator to compare estimated prices.</p>
      </aside>
    </div>
  </section>

  <section class="section comparison-section" id="compare">
    <div class="container">
      <div class="section-title">
        <p class="eyebrow">AT A GLANCE</p>
        <h2>Compare window cleaning schedules</h2>
        <p>Here is how our current pricing model treats different visit frequencies. These are <strong>model adjustments per visit</strong> compared with four-weekly service, not verified national averages.</p>
      </div>
      <div class="schedule-grid">
        {schedules.map((schedule,i) => <article class:list={['schedule-card',{highlight:i===0}]}>
          <p class="schedule-label">{schedule.label}</p>
          <h3>{schedule.name}</h3>
          <div class="schedule-number"><strong>{schedule.factor}</strong><span>price factor</span></div>
          <p class="schedule-difference">{schedule.difference}</p>
          <p class="schedule-detail">{schedule.detail}</p>
        </article>)}
      </div>
      <p class="model-note"><strong>Example:</strong> if a comparable four-weekly visit were estimated at £20 before first-clean or extra-service charges, the model would estimate approximately £21.60 at six weeks, £24 at eight weeks, £27 at twelve weeks or £31 for a one-off visit. Real quotes vary by job and business.</p>
    </div>
  </section>

  <div class="container article-shell guide-body">
    <article class="article-content">
      <section class="content-section" id="choosing">
        <h2>How to choose the right frequency</h2>
        <p>Start with the amount of dirt your property collects and how much you notice it. Glass beside busy roads, trees and exposed areas may look dirty sooner than windows in sheltered locations. Rain alone is not a reliable way to decide when a professional clean is needed.</p>
        <p>Think about the windows themselves too. If you have large panes, roof windows or difficult access, arranging a regular visit may be more convenient than booking each clean individually. Ask what is included in the visit, especially frames, sills and any conservatory glass.</p>
        <p>The right answer is the schedule you are happy to maintain at a price that works for you.</p>
      </section>
      <section class="content-section">
        <h2>Four-weekly vs six-weekly cleaning</h2>
        <p>Four-weekly cleaning keeps visits close together and is the baseline used in our calculator. Six-weekly cleaning puts a little more time between visits, but the price for each visit may rise.</p>
        <p>If you would like the windows to look consistently clear, four weeks is a reasonable starting option to quote. If they still look fine after a month, compare a six-weekly schedule rather than paying for more visits than you need.</p>
      </section>
      <section class="content-section">
        <h2>Eight-weekly and twelve-weekly cleaning</h2>
        <p>Eight-weekly cleaning can work when your main aim is periodic upkeep rather than a recently cleaned appearance all the time. At twelve weeks, some jobs may take noticeably longer because more dirt has built up.</p>
        <p>Make sure the cleaner offers the interval you want. Round planning, travel and the condition of the windows can all affect what a business is prepared to quote.</p>
      </section>
      <section class="content-section">
        <h2>What about a one-off window clean?</h2>
        <p>A one-off clean is different from an ongoing schedule. A business has no repeat visits to offset its initial travel and setup, so one-off pricing can be higher than a regular customer's visit.</p>
        <p>If you are moving house, preparing for an event or simply want the windows cleaned once, use the one-off option in our calculator. If you expect to continue, compare a regular schedule and ask whether the first visit has a separate first-clean price.</p>
        <p><a class="inline-guide-link" href="/window-cleaning-prices-uk/one-off-window-cleaning-cost/">Read the one-off window cleaning cost guide →</a></p>
      </section>
      <section class="content-section">
        <h2>Should inside windows be cleaned as often?</h2>
        <p>Not always. Fingerprints, cooking residue and other indoor marks depend on how the home is used. You may want outside windows cleaned regularly while arranging inside cleaning less often.</p>
        <p>The calculator allows inside and outside work to be considered separately, rather than assuming the same schedule for both.</p>
        <p><a class="inline-guide-link" href="/window-cleaning-prices-uk/inside-window-cleaning-cost/">See the inside window cleaning guide →</a></p>
      </section>
      <section class="content-section">
        <h2>Questions about cleaning frequency</h2>
        <div class="question-list">
          {questions.map(item=><details class="question"><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}
        </div>
      </section>
      <div class="article-end">
        <p class="eyebrow">GET A MORE SPECIFIC ESTIMATE</p>
        <h2>See how your schedule changes the price.</h2>
        <p>Enter your postcode, window types and access details, then choose the frequency that suits you. No account or email address required.</p>
        <a class="button button-primary" href="/#calculator">Use the free calculator <span aria-hidden="true">→</span></a>
      </div>
    </article>
    <aside class="article-aside" aria-label="Guide navigation">
      <div class="aside-card">
        <h2>On this page</h2>
        <a href="#compare">Compare schedules →</a>
        <a href="#choosing">Choose a frequency →</a>
        <a href="/window-cleaning-prices-uk/">All UK pricing guides →</a>
        <a href="/window-cleaning-prices-uk/how-we-calculate-prices/">How pricing works →</a>
      </div>
      <p class="aside-note">The frequency factors shown here come from this site's own estimation model. Individual window cleaners set their own prices.</p>
    </aside>
  </div>
  <section class="section section-tinted">
    <div class="container">
      <div class="section-title">
        <p class="eyebrow">EXPLORE MORE</p><h2>Useful window cleaning guides</h2>
      </div>
      <div class="guide-grid">
        <a class="guide-card" href="/window-cleaning-prices-uk/window-cleaning-prices-by-area/"><h3>Window cleaning prices by area</h3><p>See how postcode regions can affect your estimate.</p><span class="card-arrow">Read guide →</span></a>
        <a class="guide-card" href="/window-cleaning-prices-uk/first-window-cleaning-cost/"><h3>First window clean cost</h3><p>Find out why the first visit may cost more than a regular clean.</p><span class="card-arrow">Read guide →</span></a>
        <a class="guide-card" href="/window-cleaning-prices-uk/window-cleaning-cost-per-window/"><h3>Cost per window</h3><p>Understand how different types of glazing are priced.</p><span class="card-arrow">Read guide →</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .schedule-hero{background:linear-gradient(115deg,#f5f7fa 0%,#fff 65%);padding:86px 0;}
  .schedule-hero-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.85fr);gap:62px;align-items:center;}
  .schedule-hero h1{font-size:clamp(2.65rem,4.7vw,4.55rem);max-width:760px;}
  .schedule-hero .article-intro{max-width:670px;margin-bottom:26px;}
  .hero-divider{color:#ff8c42;margin:0 8px;}
  .schedule-actions{display:flex;flex-wrap:wrap;gap:12px;}
  .schedule-overview{color:#fff;background:#1e3a5f;border-radius:22px;padding:38px 30px 34px;box-shadow:0 18px 52px rgba(30,58,95,.13);}
  .overview-kicker{margin:0 0 22px;color:#c6d6e7;letter-spacing:.12em;font-size:.78rem;font-weight:800;}
  .overview-track{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;border-top:1px solid #53708e;border-bottom:1px solid #53708e;padding:22px 0;}
  .overview-track div{text-align:center;min-width:0;}
  .overview-track span{font-size:clamp(1.55rem,3.4vw,2.3rem);line-height:1.1;font-weight:780;display:block;letter-spacing:-.05em;}
  .overview-track small{display:block;margin-top:8px;color:#c6d6e7;letter-spacing:.08em;font-size:.57rem;font-weight:800;}
  .overview-title{font-size:1.35rem;line-height:1.35;font-weight:750;margin:24px 0 10px;color:#fff;}
  .overview-note{font-size:.94rem;margin:0;color:#c6d6e7;}
  .comparison-section{scroll-margin-top:110px;padding-bottom:36px;}
  .schedule-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:13px;}
  .schedule-card{border:1px solid #dce3ea;border-radius:18px;padding:23px 18px 20px;background:#fff;min-width:0;display:flex;flex-direction:column;}
  .schedule-card.highlight{border:2px solid #4a6fa5;background:#f4f8fc;padding:22px 17px 19px;}
  .schedule-label{margin:0 0 12px;font-size:.7rem;color:#4a6fa5;letter-spacing:.05em;font-weight:850;text-transform:uppercase;}
  .schedule-card h3{font-size:1.17rem;line-height:1.27;letter-spacing:-.025em;min-height:3.1rem;margin-bottom:15px;}
  .schedule-number{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;border-top:1px solid #e4ebf1;padding-top:17px;}
  .schedule-number strong{font-size:1.88rem;letter-spacing:-.06em;color:#1e3a5f;line-height:1;}
  .schedule-number span{font-size:.7rem;color:#667085;}
  .schedule-difference{font-size:.82rem;font-weight:800;color:#4a6fa5;margin:13px 0;}
  .schedule-detail{font-size:.89rem;color:#536276;margin:0;}
  .model-note{font-size:.9rem;color:#526176;border-left:3px solid #ff8c42;padding:12px 0 12px 18px;margin:22px 0 0;max-width:1000px;}
  .guide-body{padding-top:52px;}
  .inline-guide-link{color:#365f8a;font-weight:750;text-decoration:underline;text-underline-offset:3px;}
  .question-list{border-top:1px solid #dce3ea;}
  .question{border-bottom:1px solid #dce3ea;}
  .question summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:15px;padding:18px 0;cursor:pointer;color:#1e3a5f;font-weight:760;}
  .question summary::-webkit-details-marker{display:none;}
  .question summary span{font-size:1.45rem;line-height:1;color:#4a6fa5;}
  .question[open] summary span{transform:rotate(45deg);}
  .question p{padding:0 15px 12px 0;max-width:730px;}
  @media(max-width:1100px){.schedule-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:850px){.schedule-hero-grid{grid-template-columns:1fr;gap:32px}.schedule-overview{max-width:620px}.schedule-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.schedule-hero{padding:52px 0}.schedule-hero h1{font-size:clamp(2.3rem,9vw,3.1rem)}.schedule-hero-grid{gap:25px}.schedule-actions .button{width:100%}.schedule-overview{padding:26px 20px}.schedule-grid{grid-template-columns:1fr}.schedule-card,.schedule-card.highlight{padding:20px}.schedule-card h3{min-height:0}.schedule-detail{max-width:60ch}}
</style>
