---
import Base from '../layouts/Base.astro';
import pages from '../data/pages.json';
import calculator from '../widgets/calculator.html?raw';
const guides=pages.filter(page=>page.type==='guide');
const freshGuide={slug:'window-cleaning-prices-uk/how-often-should-windows-be-cleaned',heading:'How Often Should Windows Be Cleaned?',description:'Compare four-, six-, eight- and twelve-weekly cleaning, and see how frequency affects estimated prices.'};
const featured=[
 'window-cleaning-prices-uk',
 'window-cleaning-prices-uk/window-cleaning-cost-per-window',
 'window-cleaning-prices-uk/window-cleaning-prices-by-area',
 'window-cleaning-prices-uk/how-often-should-windows-be-cleaned',
 'window-cleaning-prices-uk/inside-window-cleaning-cost',
 'window-cleaning-prices-uk/conservatory-cleaning-cost'
].map(slug=>guides.find(page=>page.slug===slug) || (slug===freshGuide.slug?freshGuide:null)).filter(Boolean);
---
<Base title="Window Cleaning Cost Calculator UK | Free Local Estimates" description="Free UK window cleaning cost calculator. Compare local prices by postcode, window type, property, frequency, access and conservatory requirements." path="/">
  <section class="home-hero">
    <div class="container">
      <p class="eyebrow"><span class="eyebrow-dot"></span> FREE UK WINDOW CLEANING PRICE TOOL</p>
      <h1>Know what a window clean <em>should cost.</em></h1>
      <p class="hero-lead">Whether you are booking a cleaner or pricing a job, get a clearer estimate based on the <strong>actual windows</strong>, your location, access and frequency.</p>
      <div class="hero-actions"><a class="button button-primary" href="#calculator">Start your estimate <span aria-hidden="true">→</span></a><a class="button button-outline" href="/window-cleaning-prices-uk/">View UK price guides</a></div>
      <div class="hero-notes"><span>No account needed</span><span>Postcode-aware</span><span>Customers &amp; cleaners</span></div>
    </div>
  </section>
  <section class="calculator-section" id="calculator" aria-label="Window cleaning price calculator">
    <div class="container">
      <div class="section-title">
        <p class="eyebrow">THE CALCULATOR</p>
        <h2>A proper estimate, step by step.</h2>
        <p>Tell us what you are cleaning. We will separate standard, first-clean, inside and conservatory prices where relevant.</p>
      </div>
      <div class="calculator-host" set:html={calculator} />
      <p class="disclaimer">This is indicative pricing, not a guaranteed quote. A professional cleaner should confirm final costs.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-title"><p class="eyebrow">WHY IT WORKS</p><h2>More useful than guessing by house size.</h2><p>Two semi-detached homes can have very different amounts of glass. Our model lets you describe the actual job.</p></div>
      <div class="benefit-grid">
        <article class="benefit"><span class="benefit-no">01</span><h3>Windows &amp; access</h3><p>Count small, standard, large, bay and roof windows, plus doors and the practical access constraints.</p></article>
        <article class="benefit"><span class="benefit-no">02</span><h3>Cleaning schedule</h3><p>Account for regular, less frequent and one-off work, as well as the condition of the initial clean.</p></article>
        <article class="benefit"><span class="benefit-no">03</span><h3>Your local area</h3><p>Use postcode-region adjustments as a starting point, not an official fixed price list.</p></article>
      </div>
    </div>
  </section>
  <section class="section section-tinted">
    <div class="container">
      <div class="section-title"><p class="eyebrow">UNDERSTAND THE NUMBERS</p><h2>Window cleaning price guides</h2><p>Explore the factors behind a fair estimate and compare different types of jobs.</p></div>
      <div class="guide-grid">
        {featured.map((guide,i)=><a class="guide-card" href={'/'+guide.slug+'/'}><span class="guide-index">0{i+1}</span><h3>{guide.heading}</h3><p>{guide.description}</p><span class="card-arrow">Read guide →</span></a>)}
      </div>
      <div class="after-grid"><a class="text-link" href="/window-cleaning-prices-uk/">Browse all price guides →</a></div>
    </div>
  </section>
  <section class="section">
    <div class="container split-feature"><div><p class="eyebrow">TRANSPARENT PRICING</p><h2>What goes into your estimate?</h2><p>Window type, minimum visit cost, property height, local market, how often it is cleaned, first-clean condition, access, inside windows and conservatories.</p><p>We publish our method so cleaners can understand the assumptions and customers can ask better questions.</p><a class="button button-outline" href="/window-cleaning-prices-uk/how-we-calculate-prices/">See the pricing method →</a></div><aside class="quote-panel"><span class="quote-panel-label">Built for the real job</span><p>“A good price needs to reflect the work, not just the number of bedrooms.”</p><span>Practical pricing guidance</span></aside></div>
  </section>
</Base>
