---
import OriginalDocument from '../components/OriginalDocument.astro';
import {legacyRoutes} from '../lib/legacy-routes.mjs';
export function getStaticPaths(){
 return legacyRoutes.map(slug=>({
   params:{slug},
   props:{originalPath:slug+'/index.html'}
 }));
}
const {originalPath}=Astro.props;
---
<OriginalDocument originalPath={originalPath} />
